# ───────────────────────────────────────────────────────────
# ContentForge AI — Environment Variables
# ───────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# In production (Vercel, Netlify, etc.), add these as environment
# variables in your hosting dashboard.
# ───────────────────────────────────────────────────────────

# n8n Webhook URL
# Required. Find this in your n8n workflow:
#   1. Open your workflow in n8n
#   2. Click the "Form Trigger" node
#   3. Copy the "Production URL" under the webhook section
# Example: https://your-instance.app.n8n.cloud/webhook/abc-123-def
NEXT_PUBLIC_N8N_WEBHOOK_URL=

# Supabase (pre-provisioned — already set in the hosted environment)
# Do not change these unless you know what you're doing.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ───────────────────────────────────────────────────────────
# Notes:
#
# • If NEXT_PUBLIC_N8N_WEBHOOK_URL is empty, the app will prompt
#   the user to enter a webhook URL on first visit. The URL is
#   saved to localStorage and persists across sessions.
#
# • The webhook URL can also be changed at any time in the
#   Settings page (Dashboard → Settings).
#
# • No code changes are needed between development and production.
#   The same env var works in both environments.
# ───────────────────────────────────────────────────────────
